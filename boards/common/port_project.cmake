include("${CMAKE_CURRENT_LIST_DIR}/project_version.cmake")
set(CMAKE_NINJA_FORCE_RESPONSE_FILE ON CACHE BOOL "Use response files")
if(NOT XTOUCH_BOARD)
 message(FATAL_ERROR "Select an explicit port target with XTOUCH_BOARD")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/../port_targets.json" PORT_CATALOG)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../port_targets.json")
foreach(FIELD directory chip project backend)
 string(JSON PORT_${FIELD} GET "${PORT_CATALOG}" "${XTOUCH_BOARD}" "${FIELD}")
endforeach()
string(JSON XTOUCH_DISPLAY_WIDTH GET "${PORT_CATALOG}" "${XTOUCH_BOARD}" screen 0)
string(JSON XTOUCH_DISPLAY_HEIGHT GET "${PORT_CATALOG}" "${XTOUCH_BOARD}" screen 1)
string(JSON PORT_INDICATOR GET "${PORT_CATALOG}" "${XTOUCH_BOARD}" indicatorGpio)
string(JSON PORT_INDICATOR_SUPPORTED GET "${PORT_CATALOG}" "${XTOUCH_BOARD}" statusIndicatorSupported)
if(PORT_INDICATOR LESS 0 OR NOT PORT_INDICATOR_SUPPORTED)
 set(XTOUCH_FEATURE_INDICATOR OFF CACHE BOOL "No supported RGB status indicator on this target" FORCE)
endif()
string(JSON PORT_WAKE GET "${PORT_CATALOG}" "${XTOUCH_BOARD}" deepSleepWakeGpio)
if(PORT_WAKE LESS 0)
 set(XTOUCH_FEATURE_DEEP_SLEEP OFF CACHE BOOL "No independent deep-sleep wake input" FORCE)
endif()
set(IDF_TARGET "${PORT_chip}")
set(XTOUCH_PORT_PROFILE ON CACHE BOOL "Shared port profile")
set(XTOUCH_PORT_BACKEND "${PORT_backend}" CACHE STRING "Display transport" FORCE)
set(XTOUCH_UI_NATIVE_CANVAS ON CACHE BOOL "Native canvas")
set(SDKCONFIG_DEFAULTS "${CMAKE_CURRENT_LIST_DIR}/../sdkconfig.defaults;${CMAKE_CURRENT_LIST_DIR}/../${PORT_directory}/sdkconfig.defaults;${CMAKE_CURRENT_LIST_DIR}/sdkconfig.xiaomi_ble.defaults")
if(PORT_chip STREQUAL "esp32p4")
 list(APPEND SDKCONFIG_DEFAULTS "${CMAKE_CURRENT_LIST_DIR}/sdkconfig.hosted_ble.defaults")
endif()
get_filename_component(PORT_CSV_SOURCE "${CMAKE_CURRENT_LIST_DIR}/../${PORT_directory}/partitions.csv" ABSOLUTE)
set(PORT_CSV_COPY "${CMAKE_BINARY_DIR}/selected-partitions.csv")
configure_file("${PORT_CSV_SOURCE}" "${PORT_CSV_COPY}" COPYONLY)
# A target name in this otherwise unused SDK string invalidates every SDK object.
# Keep the build copy stable while still copying and validating the selected board's layout.
if(SDKCONFIG AND EXISTS "${SDKCONFIG}")
 file(READ "${SDKCONFIG}" PORT_SDK_TEXT)
 string(REGEX MATCH "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"([^\"]*)\"" PORT_PARTITION_SETTING "${PORT_SDK_TEXT}")
 set(PORT_EXISTING_CSV "${CMAKE_MATCH_1}")
 get_filename_component(PORT_EXISTING_CSV_ABS "${PORT_EXISTING_CSV}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
 if(PORT_EXISTING_CSV STREQUAL "partitions.csv" OR PORT_EXISTING_CSV_ABS STREQUAL PORT_CSV_SOURCE)
  string(REPLACE "${PORT_PARTITION_SETTING}" "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"${PORT_CSV_COPY}\"" PORT_SDK_NEW "${PORT_SDK_TEXT}")
  if(NOT PORT_SDK_NEW STREQUAL PORT_SDK_TEXT)
   file(WRITE "${SDKCONFIG}" "${PORT_SDK_NEW}")
  endif()
 endif()
endif()
set(PORT_PARTITIONS_TEXT "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"${PORT_CSV_COPY}\"\n")
set(PORT_PARTITIONS_OLD "")
if(EXISTS "${CMAKE_BINARY_DIR}/port-partitions.defaults")
 file(READ "${CMAKE_BINARY_DIR}/port-partitions.defaults" PORT_PARTITIONS_OLD)
endif()
if(NOT PORT_PARTITIONS_TEXT STREQUAL PORT_PARTITIONS_OLD)
 file(WRITE "${CMAKE_BINARY_DIR}/port-partitions.defaults" "${PORT_PARTITIONS_TEXT}")
endif()
list(APPEND SDKCONFIG_DEFAULTS "${CMAKE_BINARY_DIR}/port-partitions.defaults")
set(EXTRA_COMPONENT_DIRS "${CMAKE_CURRENT_LIST_DIR}/../main" "${CMAKE_CURRENT_LIST_DIR}/../.deps/lvgl" "${CMAKE_CURRENT_LIST_DIR}/../port-support")
include($ENV{IDF_PATH}/tools/cmake/project.cmake)
if(PORT_chip STREQUAL "esp32s3")
 set(PORT_LOCK_TARGET s3)
else()
 set(PORT_LOCK_TARGET p4)
endif()
set(DEPENDENCIES_LOCK "${CMAKE_CURRENT_LIST_DIR}/../port-project-${PORT_LOCK_TARGET}/dependencies.lock")
idf_build_set_property(DEPENDENCIES_LOCK "${DEPENDENCIES_LOCK}")
set(COMPONENTS main)
