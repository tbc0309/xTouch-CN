# Decide optional interaction modules before SDK Bluetooth defaults are selected.
set(XTOUCH_INTERACTIVE_DEFAULT OFF)
if(IDF_TARGET STREQUAL "esp32s3" OR IDF_TARGET STREQUAL "esp32p4")
 set(XTOUCH_INTERACTIVE_DEFAULT ON)
endif()
set(XTOUCH_GCODE_DEFAULT ${XTOUCH_INTERACTIVE_DEFAULT})
if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/../${XTOUCH_BOARD}/storage.cpp")
 set(XTOUCH_GCODE_DEFAULT OFF)
endif()
option(XTOUCH_FEATURE_GCODE_BROWSER "Include SD-backed printer file browser" ${XTOUCH_GCODE_DEFAULT})
if(XTOUCH_FEATURE_GCODE_BROWSER AND NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/../${XTOUCH_BOARD}/storage.cpp")
 message(FATAL_ERROR "File browser requires a mapped boards/${XTOUCH_BOARD}/storage.cpp adapter")
endif()
set(XTOUCH_PIXEL_DEFAULT ${XTOUCH_INTERACTIVE_DEFAULT})
if(XTOUCH_FEATURE_BLE_PROVISIONING)
 set(XTOUCH_PIXEL_DEFAULT OFF)
endif()
option(XTOUCH_FEATURE_PIXEL_SCREEN "Include pixel screen BLE connection and rendering" ${XTOUCH_PIXEL_DEFAULT})
