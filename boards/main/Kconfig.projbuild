# Arduino 3.3.12 still gates its Wi-Fi and Hosted wrappers on the 2.x name.
# Hosted 3 uses ESP_HOSTED_HOST. Keep aliases while the Arduino wrappers use their previous names.
config ESP_HOSTED_ENABLED
    bool
    default y if ESP_HOSTED_HOST

config IDF_SLAVE_TARGET
    string
    default ESP_HOSTED_IDF_SLAVE_TARGET
    depends on ESP_HOSTED_HOST
