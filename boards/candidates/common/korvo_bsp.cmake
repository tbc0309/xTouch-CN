# Local build-only correction for esp-bsp f259a6abd5808019b1903a422092a4234ca95a51.
# The disabled graphics path must not declare an LVGL-owned input object.
idf_component_get_property(KORVO_SOURCE_DIR espressif__esp32_s3_korvo_2 COMPONENT_DIR)
idf_component_get_property(KORVO_COMPONENT espressif__esp32_s3_korvo_2 COMPONENT_LIB)
set(KORVO_DISPLAY_SOURCE "${KORVO_SOURCE_DIR}/src/bsp_display.c")
file(READ "${KORVO_DISPLAY_SOURCE}" KORVO_SOURCE_TEXT)
string(REPLACE "\r\n" "\n" KORVO_SOURCE_TEXT "${KORVO_SOURCE_TEXT}")
string(SHA256 KORVO_SOURCE_HASH "${KORVO_SOURCE_TEXT}")
if(NOT KORVO_SOURCE_HASH STREQUAL "25fe30082a06433782c04dd81a60a8d3ab83d138a00bcb1dfbcd2ea8497a19c9")
 message(FATAL_ERROR "Korvo BSP source changed; review the graphics-disabled correction before rebuilding")
endif()
string(REPLACE "static lv_indev_t *disp_indev_touch = NULL;"
 "#if (BSP_CONFIG_NO_GRAPHIC_LIB == 0)\nstatic lv_indev_t *disp_indev_touch = NULL;\n#endif"
 KORVO_PATCHED_TEXT "${KORVO_SOURCE_TEXT}")
set(KORVO_PATCHED_SOURCE "${CMAKE_BINARY_DIR}/generated/korvo_bsp_display.c")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated")
if(EXISTS "${KORVO_PATCHED_SOURCE}")
 file(READ "${KORVO_PATCHED_SOURCE}" KORVO_PREVIOUS_TEXT)
endif()
if(NOT KORVO_PREVIOUS_TEXT STREQUAL KORVO_PATCHED_TEXT)
 file(WRITE "${KORVO_PATCHED_SOURCE}" "${KORVO_PATCHED_TEXT}")
endif()
# The handle-returning initializer must return NULL on an IDF error.
file(READ "${KORVO_SOURCE_DIR}/src/bsp_io_expander.c" KORVO_IO_TEXT)
string(REPLACE "\r\n" "\n" KORVO_IO_TEXT "${KORVO_IO_TEXT}")
string(SHA256 KORVO_IO_HASH "${KORVO_IO_TEXT}")
if(NOT KORVO_IO_HASH STREQUAL "180ba31bbaa2d0fc58d023359167482312b2ce06fa324464a499abfa67720403")
 message(FATAL_ERROR "Korvo expander source changed; review the error-return correction")
endif()
string(REPLACE "BSP_ERROR_CHECK_RETURN_ERR(" "BSP_ERROR_CHECK_RETURN_NULL(" KORVO_IO_TEXT "${KORVO_IO_TEXT}")
string(REPLACE "#if CONFIG_IO_EXPANDER_ENABLE_GPIO_API_WRAPPER"
 "if (!io_expander) return NULL;\n#if CONFIG_IO_EXPANDER_ENABLE_GPIO_API_WRAPPER" KORVO_IO_TEXT "${KORVO_IO_TEXT}")
set(KORVO_PATCHED_IO "${CMAKE_BINARY_DIR}/generated/korvo_bsp_io_expander.c")
if(EXISTS "${KORVO_PATCHED_IO}")
 file(READ "${KORVO_PATCHED_IO}" KORVO_PREVIOUS_IO)
endif()
if(NOT KORVO_PREVIOUS_IO STREQUAL KORVO_IO_TEXT)
 file(WRITE "${KORVO_PATCHED_IO}" "${KORVO_IO_TEXT}")
endif()
get_target_property(KORVO_SOURCES ${KORVO_COMPONENT} SOURCES)
set(KORVO_REPLACED 0)
set(KORVO_FINAL_SOURCES "")
foreach(KORVO_FILE IN LISTS KORVO_SOURCES)
 if(KORVO_FILE MATCHES "(^|/)bsp_display[.]c$")
  list(APPEND KORVO_FINAL_SOURCES "${KORVO_PATCHED_SOURCE}")
  math(EXPR KORVO_REPLACED "${KORVO_REPLACED}+1")
 elseif(KORVO_FILE MATCHES "(^|/)bsp_io_expander[.]c$")
  list(APPEND KORVO_FINAL_SOURCES "${KORVO_PATCHED_IO}")
  math(EXPR KORVO_REPLACED "${KORVO_REPLACED}+1")
 else()
  list(APPEND KORVO_FINAL_SOURCES "${KORVO_FILE}")
 endif()
endforeach()
if(NOT KORVO_REPLACED EQUAL 2)
 message(FATAL_ERROR "Korvo BSP display source was not uniquely identified")
endif()
set_property(TARGET ${KORVO_COMPONENT} PROPERTY SOURCES "${KORVO_FINAL_SOURCES}")
